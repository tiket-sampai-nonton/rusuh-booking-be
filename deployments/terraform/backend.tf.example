# Salin ke backend.tf setelah bucket state dibuat (lihat README, "Bootstrap state").
terraform {
  backend "s3" {
    bucket       = "rusuh-tfstate-<account-id>"
    key          = "rusuh/prod/terraform.tfstate" # ganti prod/staging sesuai environment
    region       = "ap-southeast-2"
    encrypt      = true
    use_lockfile = true
  }
}

# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/payment.env (chmod 600). Jangan commit hasilnya.
APP_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
APP_NAME=payment
APP_PORT=8083
WORKER_INTERVAL=5s
POSTGRES_USER=svc_payment
POSTGRES_PASSWORD=@@PAYMENT_DB_PASSWORD@@
POSTGRES_SCHEMA=payment
RABBITMQ_URL=amqp://rusuh:@@RABBITMQ_PASSWORD@@@rabbitmq:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
# DEV di VPS bersama: gateway penyedia meneruskan HTTPS tanpa IP klien, jadi semua pengunjung terlihat dari satu IP (10.10.0.1).
# Batas per-IP dilonggarkan agar tidak menghukum semua orang sekaligus. Di AWS (ALB/CloudFront) IP klien terbaca dan nilai bawaan dipakai.
RATE_LIMIT_PER_IP=3000
RATE_LIMIT_WEBHOOK_PER_IP=600
RATE_LIMIT_WINDOW=1m
BOOKING_SERVICE_URL=http://booking-api:8082
TOKEN_PUBLIC_KEY_FILE=/run/keys/queue-token.pub.pem
SERVICE_TOKEN_PRIVATE_KEY_FILE=/run/keys/payment-token.pem
BOOKING_TOKEN_PUBLIC_KEY_FILE=/run/keys/booking-token.pub.pem
# Halaman FE tujuan setelah Snap selesai (isi alamat FE dev).
PAYMENT_SUCCESS_RETURN_URL=@@SET_PAYMENT_SUCCESS_RETURN_URL@@
PAYMENT_FAILED_RETURN_URL=@@SET_PAYMENT_FAILED_RETURN_URL@@
PAYMENT_METHODS_ENABLED=VA_BCA,VA_BNI,VA_BRI,QRIS,GOPAY
# Midtrans Sandbox. URL webhook diatur di dashboard Midtrans: https://<domain>/api/v1/webhooks/midtrans
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=@@SET_MIDTRANS_SERVER_KEY@@

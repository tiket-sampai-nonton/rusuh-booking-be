# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/compose.env (chmod 600). Jangan commit hasilnya.
# Dipakai Caddy (Caddyfile) dan deploy.sh.
DEV_DOMAIN=@@SET_DEV_DOMAIN@@
ACME_EMAIL=@@SET_ACME_EMAIL@@
# IP/CIDR yang boleh memanggil /internal/v1/admin/* lewat Caddy (IP publik Anda); default loopback = tidak ada.
ADMIN_ALLOW_IPS=127.0.0.1

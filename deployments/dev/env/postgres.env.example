# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/postgres.env (chmod 600). Jangan commit hasilnya.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=@@POSTGRES_SUPERUSER_PASSWORD@@
POSTGRES_DB=rbt
QUEUE_DB_PASSWORD=@@QUEUE_DB_PASSWORD@@
BOOKING_DB_PASSWORD=@@BOOKING_DB_PASSWORD@@
PAYMENT_DB_PASSWORD=@@PAYMENT_DB_PASSWORD@@
NOTIFICATION_DB_PASSWORD=@@NOTIFICATION_DB_PASSWORD@@
USER_DB_PASSWORD=@@USER_DB_PASSWORD@@

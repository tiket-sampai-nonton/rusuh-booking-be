# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/rabbitmq.env (chmod 600). Jangan commit hasilnya.
RABBITMQ_DEFAULT_USER=rusuh
RABBITMQ_DEFAULT_PASS=@@RABBITMQ_PASSWORD@@

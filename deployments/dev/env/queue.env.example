# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/queue.env (chmod 600). Jangan commit hasilnya.
APP_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
APP_NAME=queue
# CORS: origin FE yang boleh memanggil API dari browser (pisah koma, persis sama). Kosong = wildcard tanpa cookie.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://rusuh-booking.pages.dev
# none = cookie boleh dikirim lintas-situs (FE di localhost/pages.dev). Wajib bersama CORS_ALLOWED_ORIGINS. Prod same-site: biarkan lax.
COOKIE_SAMESITE=none
APP_PORT=8081
WORKER_INTERVAL=5s
# Profil skala besar: heartbeat 120 s (near tetap 10 s) menurunkan ~10.000 ke ~2.500 RPS pada 300 ribu pengantre.
# Harus STALE > 2x interval dan END > STALE. Konsekuensi: pengantre yang pergi baru dilewati setelah 5 menit (default SRS 90/300 s).
QUEUE_HEARTBEAT_INTERVAL_SECONDS=120
QUEUE_HEARTBEAT_NEAR_INTERVAL_SECONDS=10
QUEUE_STALE_AFTER_SECONDS=300
QUEUE_END_AFTER_SECONDS=600
POSTGRES_USER=svc_queue
POSTGRES_PASSWORD=@@QUEUE_DB_PASSWORD@@
POSTGRES_SCHEMA=queue
VALKEY_SERVER=[{"host":"valkey","port":6379}]
VALKEY_PASSWORD=@@VALKEY_PASSWORD@@
VALKEY_TLS=false
VALKEY_DB=0
RABBITMQ_URL=amqp://rusuh:@@RABBITMQ_PASSWORD@@@rabbitmq:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
BOOKING_SERVICE_URL=http://booking-api:8082
TOKEN_ISSUER=rbt-queue
TOKEN_AUDIENCE=rbt
TOKEN_KEY_ID=queue-1
TOKEN_PRIVATE_KEY_FILE=/run/keys/queue-token.pem
TOKEN_PUBLIC_KEY_FILE=/run/keys/user-token.pub.pem
# Email (atau @domain, dipisah koma) yang boleh memakai endpoint admin pengaturan antrean; kosong = tidak ada yang boleh.
ADMIN_EMAILS=@@SET_ADMIN_EMAILS@@
PII_HMAC_KEY=@@PII_HASH_KEY@@
# DEV di VPS bersama: gateway penyedia meneruskan HTTPS tanpa IP klien, jadi semua pengunjung terlihat dari satu IP (10.10.0.1).
# Batas per-IP dilonggarkan agar tidak menghukum semua orang sekaligus. Di AWS (ALB/CloudFront) IP klien terbaca dan nilai bawaan dipakai.
RATE_LIMIT_JOIN_PER_IP=100000

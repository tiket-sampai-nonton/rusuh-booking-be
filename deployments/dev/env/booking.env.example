# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/booking.env (chmod 600). Jangan commit hasilnya.
APP_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
APP_NAME=booking
APP_PORT=8082
WORKER_INTERVAL=5s
POSTGRES_USER=svc_booking
POSTGRES_PASSWORD=@@BOOKING_DB_PASSWORD@@
POSTGRES_SCHEMA=booking
VALKEY_SERVER=[{"host":"valkey","port":6379}]
VALKEY_PASSWORD=@@VALKEY_PASSWORD@@
VALKEY_TLS=false
VALKEY_DB=0
RABBITMQ_URL=amqp://rusuh:@@RABBITMQ_PASSWORD@@@rabbitmq:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
# DEV di VPS bersama: gateway penyedia meneruskan HTTPS tanpa IP klien, jadi semua pengunjung terlihat dari satu IP (10.10.0.1).
# Batas per-IP dilonggarkan agar tidak menghukum semua orang sekaligus. Di AWS (ALB/CloudFront) IP klien terbaca dan nilai bawaan dipakai.
RATE_LIMIT_PER_IP=3000
RATE_LIMIT_WINDOW=1m
TOKEN_PUBLIC_KEY_PATH=/run/keys/queue-token.pub.pem
USER_TOKEN_PUBLIC_KEY_PATH=/run/keys/user-token.pub.pem
PAYMENT_SERVICE_URL=http://payment-api:8083
SERVICE_TOKEN_PRIVATE_KEY_PATH=/run/keys/booking-token.pem
PAYMENT_TOKEN_PUBLIC_KEY_PATH=/run/keys/payment-token.pub.pem
# Email (atau @domain, dipisah koma) yang boleh memakai endpoint admin; kosong = tidak ada yang boleh.
ADMIN_EMAILS=@@SET_ADMIN_EMAILS@@
PII_ENC_KEY=@@PII_ENC_KEY@@
PII_HASH_KEY=@@PII_HASH_KEY@@
TICKET_LINK_KEY=@@TICKET_LINK_KEY@@
# Gambar event disimpan di volume lokal dan dilayani Caddy di /media (dev saja; prod memakai s3).
IMAGE_STORAGE=local
IMAGE_LOCAL_DIR=/data/images
IMAGE_PUBLIC_BASE_URL=https://@@SET_DEV_DOMAIN@@/media

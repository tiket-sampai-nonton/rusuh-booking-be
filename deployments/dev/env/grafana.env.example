# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/grafana.env (chmod 600). Jangan commit hasilnya.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=@@GRAFANA_PASSWORD@@
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SERVER_ROOT_URL=https://grafana.@@SET_DEV_DOMAIN@@
# Alert NFR-09 lewat email (SRS-F-90-06) memakai SMTP Resend. Password = API key Resend KHUSUS Grafana dengan izin
# "Sending access" terbatas ke domain pengirim, terpisah dari key notification (bisa dicabut tanpa mengganggu email
# tiket). STARTTLS wajib: tanpa itu key bisa terkirim tanpa enkripsi bila negosiasi TLS gagal. Penerima = admin tim.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.resend.com:587
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
GF_SMTP_USER=resend
GF_SMTP_PASSWORD=@@SET_GRAFANA_SMTP_KEY@@
GF_SMTP_FROM_ADDRESS=grafana@send.rusuhbooking.my.id
GF_SMTP_FROM_NAME=RBT Grafana dev
RBT_ALERT_EMAILS=@@SET_ADMIN_EMAILS@@

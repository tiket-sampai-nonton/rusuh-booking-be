# Dev VPS. gen-secrets.sh membuat env sebenarnya dari template ini: nilai acak dibuat otomatis, nilai SET_* diisi dari variabel lingkungan atau manual.
# File ini disalin ke /opt/rusuh/env/notification.env (chmod 600). Jangan commit hasilnya.
APP_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
APP_NAME=notification
APP_PORT=8084
WORKER_INTERVAL=5s
POSTGRES_USER=svc_notification
POSTGRES_PASSWORD=@@NOTIFICATION_DB_PASSWORD@@
POSTGRES_SCHEMA=notification
RABBITMQ_URL=amqp://rusuh:@@RABBITMQ_PASSWORD@@@rabbitmq:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@send.rusuhbooking.my.id
RESEND_API_KEY=@@SET_RESEND_API_KEY@@
PII_ENC_KEY=@@PII_ENC_KEY@@
PII_HASH_KEY=@@PII_HASH_KEY@@
TOKEN_PUBLIC_KEY_FILE=/run/keys/queue-token.pub.pem
TOKEN_KEY_ID=queue-1
TOKEN_ISSUER=rbt-queue
TOKEN_AUDIENCE=rbt
# Halaman FE yang menampilkan e-tiket: {base}/{bookingId}?t={token}. Kosong = email tanpa tautan.
TICKET_LINK_BASE_URL=@@SET_TICKET_LINK_BASE_URL@@

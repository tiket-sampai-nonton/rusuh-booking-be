# Salin ke .env untuk menjalankan `go run ./cmd api` dari services/notification. Jangan commit secret asli.
APP_ENV=local
APP_NAME=notification
APP_PORT=8084
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
WORKER_INTERVAL=5s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svc_notification
POSTGRES_PASSWORD=notification-local-only
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_SCHEMA=notification
POSTGRES_MAX_CONNS=10

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_WORKERS=4
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAYS=5s,30s,2m
RABBITMQ_CONFIRM_TIMEOUT=5s

# ---- Penyedia email (notification task 0c; dibaca setelah task itu dikerjakan) ----
# mailpit = SMTP ke Mailpit (lokal/CI, tidak ada email keluar); resend = email nyata via Resend
EMAIL_PROVIDER=mailpit
# Pengirim; untuk resend harus memakai domain yang sudah diverifikasi di Resend
EMAIL_FROM=no-reply@rusuh.test
# Hanya untuk resend. JANGAN commit nilai asli.
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# PII (32-byte hex), nilai lokal saja. PII_ENC_KEY harus sama dengan producer (User) agar email_enc bisa didekripsi.
PII_ENC_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
PII_HASH_KEY=101112131415161718191a1b1c1d1e1f000102030405060708090a0b0c0d0e0f

# Verifikasi X-Visitor-Token milik Queue (kunci publik Queue; issuer/audience/kid harus sama dengan Queue)
TOKEN_PUBLIC_KEY_FILE=../../deployments/compose/keys/queue-token.pub.pem
TOKEN_KEY_ID=queue-1
TOKEN_ISSUER=rbt-queue
TOKEN_AUDIENCE=rbt

# Salin ke .env untuk menjalankan `go run ./cmd api` dari services/booking. Jangan commit secret asli.
APP_ENV=local
APP_NAME=booking
APP_PORT=8082
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
WORKER_INTERVAL=5s

# Rate limit per IP, dalam-memori per instance (0 = nonaktif). /health dan /metrics dikecualikan.
RATE_LIMIT_PER_IP=300
RATE_LIMIT_WINDOW=1m

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svc_booking
POSTGRES_PASSWORD=booking-local-only
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_SCHEMA=booking
POSTGRES_MAX_CONNS=10

VALKEY_SERVER=[{"host":"localhost","port":6379}]
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_TLS=false
VALKEY_DB=0
VALKEY_PREFIX_ENV=

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_WORKERS=4
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAYS=5s,30s,2m
RABBITMQ_CONFIRM_TIMEOUT=5s

# ---- Token antar service (payment task 15) ----
# Kunci publik Payment: memverifikasi panggilan Payment ke /internal/v1/bookings/{id}/payable dan /payment-lock.
# Tanpa ini kedua endpoint menolak semua permintaan (fail-closed).
PAYMENT_TOKEN_PUBLIC_KEY_PATH=../../deployments/compose/keys/payment-token.pub.pem
# Kunci privat Booking: menandatangani service token (5 menit) untuk memanggil Payment (resolve). Tanpa ini expiry dan cancel menolak.
SERVICE_TOKEN_PRIVATE_KEY_PATH=../../deployments/compose/keys/booking-token.pem
PAYMENT_SERVICE_URL=http://localhost:8083
# Nilai bawaan: SERVICE_TOKEN_KEY_ID=booking-1, SERVICE_TOKEN_ISSUER=rbt-booking, PAYMENT_TOKEN_AUDIENCE=rbt-payment,
# PAYMENT_TOKEN_KEY_ID=payment-1, PAYMENT_TOKEN_ISSUER=rbt-payment

# Admin (/internal/v1/admin/*): token pembeli User Service milik email berikut saja (pisahkan koma; "@domain" = seluruh domain
# yang Anda kuasai, mis. untuk E2E lokal). Kosong = tidak ada yang boleh (fail closed).
ADMIN_EMAILS=

# Unggah gambar event (API admin). local = direktori yang di-ignore git, dilayani di /media; s3 = bucket AWS.
IMAGE_STORAGE=local
IMAGE_LOCAL_DIR=var/images
IMAGE_PUBLIC_BASE_URL=http://localhost:8082/media
# IMAGE_S3_BUCKET=            # wajib untuk s3 (output Terraform images_bucket); kredensial dari role task/instance
# IMAGE_S3_ENDPOINT=          # opsional: endpoint S3-compatible (LocalStack)

# Salin ke .env untuk menjalankan `go run ./cmd api` dari services/user. Jangan commit secret asli.
APP_ENV=local
APP_NAME=user
APP_PORT=8085
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=user-local-only
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_SCHEMA=users
POSTGRES_MAX_CONNS=10

VALKEY_SERVER=[{"host":"localhost","port":6379}]
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_TLS=false
VALKEY_DB=0
VALKEY_PREFIX_ENV=

TOKEN_ISSUER=rbt-user
TOKEN_AUDIENCE=rbt
TOKEN_KEY_ID=user-1
TOKEN_PRIVATE_KEY_FILE=../../deployments/compose/keys/user-token.pem
TOKEN_ACCESS_TTL=15m
TOKEN_REFRESH_TTL=720h

OTP_TTL=5m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_EMAIL_HOUR=5
OTP_MAX_PER_IP_HOUR=20

# 32 byte hex. Nilai di bawah hanya untuk lokal.
PII_ENC_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
PII_HASH_KEY=101112131415161718191a1b1c1d1e1f000102030405060708090a0b0c0d0e0f
OTP_HASH_KEY=202122232425262728292a2b2c2d2e2f000102030405060708090a0b0c0d0e0f

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Rusuh Booking Tiket <no-reply@rusuh.test>
SMTP_TIMEOUT=5s

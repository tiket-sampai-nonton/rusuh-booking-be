# Salin ke .env untuk menjalankan `go run ./cmd api` dari services/payment. Jangan commit secret asli.
APP_ENV=local
APP_NAME=payment
APP_PORT=8083
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
WORKER_INTERVAL=5s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svc_payment
POSTGRES_PASSWORD=payment-local-only
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_SCHEMA=payment
POSTGRES_MAX_CONNS=10

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_WORKERS=4
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAYS=5s,30s,2m
RABBITMQ_CONFIRM_TIMEOUT=5s

# ---- Payment (payment task 0.1; kunci Midtrans dan file kunci wajib untuk api/worker) ----
# Metode yang tampil di halaman bayar
PAYMENT_METHODS_ENABLED=VA_BCA,VA_BNI,VA_BRI,QRIS,GOPAY
# TTL token WebView sekali pakai (30-120)
PAYMENT_PAGE_TOKEN_TTL_SECONDS=60
# Service lain
BOOKING_SERVICE_URL=http://localhost:8082
# Kunci publik Queue untuk verifikasi visitor token (dibuat oleh `make keys`)
TOKEN_PUBLIC_KEY_FILE=../../deployments/compose/keys/queue-token.pub.pem
# Kunci privat Payment: menandatangani service token ke Booking dan cookie rb_pay
SERVICE_TOKEN_PRIVATE_KEY_FILE=../../deployments/compose/keys/payment-token.pem
# Kunci publik Booking: memverifikasi panggilan Booking ke /internal/v1/payments/*
BOOKING_TOKEN_PUBLIC_KEY_FILE=../../deployments/compose/keys/booking-token.pub.pem

# ---- Midtrans (isi dari Settings > Access Keys; JANGAN commit nilai asli) ----
MIDTRANS_ENVIRONMENT=sandbox
# Server key hanya di .env lokal / secret deploy; jangan commit nilai asli
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
# Hanya untuk tes lokal lewat tunnel (https): URL notifikasi per transaksi. Kosongkan di staging dan produksi.
MIDTRANS_NOTIFICATION_URL=
# Circuit breaker + bulkhead (nilai awal PROPOSED, SDD-RBT 4.6.2)
MIDTRANS_CHARGE_TIMEOUT=3s
MIDTRANS_CHARGE_FAILURE_THRESHOLD=5
MIDTRANS_CHARGE_COOLDOWN=20s
MIDTRANS_CHARGE_BULKHEAD=20
MIDTRANS_STATUS_TIMEOUT=2s
MIDTRANS_STATUS_FAILURE_THRESHOLD=5
MIDTRANS_STATUS_COOLDOWN=15s
MIDTRANS_STATUS_BULKHEAD=10

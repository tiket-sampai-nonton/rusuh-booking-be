# Salin ke .env untuk menjalankan `go run ./cmd api` dari services/queue. Jangan commit secret asli.
APP_ENV=local
APP_NAME=queue
APP_PORT=8081
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_SHUTDOWN_TIMEOUT=15s
HEALTH_TIMEOUT=2s
WORKER_INTERVAL=5s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svc_queue
POSTGRES_PASSWORD=queue-local-only
POSTGRES_DATABASE=rbt
POSTGRES_SSLMODE=disable
POSTGRES_SCHEMA=queue
POSTGRES_MAX_CONNS=10

VALKEY_SERVER=[{"host":"localhost","port":6379}]
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_TLS=false
VALKEY_DB=0
VALKEY_PREFIX_ENV=

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=rusuh.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_WORKERS=4
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAYS=5s,30s,2m
RABBITMQ_CONFIRM_TIMEOUT=5s

# Booking Service (outbound) — reserve allocations + supply snapshot
BOOKING_SERVICE_URL=http://localhost:8082
# Public booking page (web), returned by claim as {BOOKING_PAGE_BASE_URL}/{eventId}. Wajib; http hanya untuk APP_ENV=local.
BOOKING_PAGE_BASE_URL=http://localhost:3000/book
BOOKING_TIMEOUT=3s

# Tokens (EdDSA, pkg/token). Private key signs admission/visitor/queue tokens.
# Public key verifies User Service buyer bearer tokens (same shared key).
TOKEN_ISSUER=rbt-queue
TOKEN_AUDIENCE=rbt
TOKEN_KEY_ID=queue-1
TOKEN_PRIVATE_KEY_FILE=../../deployments/compose/keys/queue-token.pem
TOKEN_PUBLIC_KEY_FILE=../../deployments/compose/keys/user-token.pub.pem
TOKEN_ADMISSION_TTL=60s
TOKEN_VISITOR_TTL=24h
TOKEN_QUEUE_TTL=1h

# PII keys (32-byte hex), nilai lokal saja. PII_HMAC_KEY HARUS sama dengan PII_HASH_KEY User Service agar nik_hash cocok.
PII_ENC_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
PII_HMAC_KEY=101112131415161718191a1b1c1d1e1f000102030405060708090a0b0c0d0e0f

# Worker tuning (Go duration strings). Per-event event_settings is the source of truth; these are fallbacks.
QUEUE_PROMOTOR_INTERVAL_MS=100ms
QUEUE_SWEEPER_INTERVAL_MS=10s
QUEUE_STATUS_INTERVAL_MS=1s
QUEUE_PROMOTE_BATCH_MAX=200

# Rate limits (fixed window). Status Document endpoint is NOT rate-limited at origin.
RATE_LIMIT_JOIN_PER_EMAIL=5
RATE_LIMIT_JOIN_PER_IP=60
RATE_LIMIT_ME_PER_VISITOR=120
RATE_LIMIT_JOIN_PER_EMAIL_WINDOW=1m
RATE_LIMIT_JOIN_PER_IP_WINDOW=1m
RATE_LIMIT_ME_PER_VISITOR_WINDOW=1m

# Queue hardening (QSH): lease/fence, sweep bound, unreadable-PII, poison-head detection. Validated at start (D-24).
# Lease TTL: > 2x BOOKING_TIMEOUT, between 2s and 30s. The promoter and join direct admission share this lease.
QUEUE_PROMOTER_LEASE_TTL_MS=10s
QUEUE_SWEEP_BATCH_MAX=500
QUEUE_UNSEAL_FAIL_MAX=3
QUEUE_UNSEAL_PROBE=3
# Head answers NO_SUPPLY_NOW this many unbroken ticks => counted (never acted on). Minimum 2.
QUEUE_NO_SUPPLY_SUSPECT_TICKS=50
# CLAIMED slot upper bound (seconds, minimum 600). Invariant: must be >= Booking max selection TTL 1800 + submit grace 30
# + payment TTL 3600 + deadline extension 600 + VERIFY_GRACE_SECONDS 600 (= 6630 s at Booking's maxima).
QUEUE_CLAIMED_SLOT_MAX_SECONDS=7200

# Admin pengaturan antrean (/internal/v1/admin/events/{eventId}/queue-settings): token pembeli User Service milik email berikut
# saja (pisahkan koma; "@domain" = seluruh domain yang Anda kuasai). Kosong = tidak ada yang boleh (fail closed).
# Butuh TOKEN_PUBLIC_KEY_FILE (kunci publik User Service); tanpa itu endpoint menolak semua permintaan.
# Ini daftar izin akses, bukan nilai bawaan kapasitas: kapasitas hanya diisi lewat endpoint (PUT) setelah event terbit.
ADMIN_EMAILS=

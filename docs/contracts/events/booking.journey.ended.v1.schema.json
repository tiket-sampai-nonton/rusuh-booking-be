{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "booking.journey.ended.v1.schema.json",
  "title": "Payload booking.journey.ended.v1",
  "description": "Payload di dalam envelope. Tidak memuat NIK plaintext, secret, atau token selain ticketLinkToken untuk email.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "queueEntryId": {
      "type": "string",
      "format": "uuid"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PAID",
        "EXPIRED",
        "CANCELLED",
        "LEFT_WITHOUT_BUYING",
        "UNCLAIMED"
      ]
    }
  },
  "required": [
    "eventId",
    "queueEntryId",
    "outcome"
  ],
  "additionalProperties": false
}

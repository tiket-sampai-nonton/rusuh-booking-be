{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "booking.expired.v1.schema.json",
  "title": "Payload booking.expired.v1",
  "description": "Payload di dalam envelope. Tidak memuat NIK plaintext, secret, atau token selain ticketLinkToken untuk email.",
  "type": "object",
  "properties": {
    "bookingId": {
      "type": "string",
      "format": "uuid"
    },
    "publicRef": {
      "type": "string"
    },
    "buyerEmail": {
      "type": "string",
      "format": "email"
    },
    "reason": {
      "type": "string",
      "enum": [
        "PAYMENT_TIMEOUT",
        "SESSION_EXPIRED",
        "CANCELLED"
      ]
    }
  },
  "required": [
    "bookingId",
    "publicRef",
    "buyerEmail",
    "reason"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payment.failed.v1.schema.json",
  "title": "Payload payment.failed.v1",
  "description": "Payload di dalam envelope. Tidak memuat NIK plaintext, secret, atau token selain ticketLinkToken untuk email.",
  "type": "object",
  "properties": {
    "bookingId": {
      "type": "string",
      "format": "uuid"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "bookingId",
    "attemptId",
    "reason"
  ],
  "additionalProperties": false
}
